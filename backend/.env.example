# ---------------------------------------------------------------------------
# Melobud backend configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase Postgres connection string.
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543), e.g.
# postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# The transaction pooler is recommended: the session pooler (port 5432) allows only
# 15 simultaneous clients on the free plan. Keep DB_TRANSACTION_POOLER=true with port 6543.
DATABASE_URL=
DB_SSL_REQUIRE=true
DB_TRANSACTION_POOLER=true

# Background jobs. Leave empty to run analysis in a background thread inside
# Django (works without Redis). Set to use Celery, e.g. redis://127.0.0.1:6379/0
REDIS_URL=

# SMTP (required for sign-up verification and password reset emails).
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587, SMTP_USERNAME=<you>@gmail.com,
# SMTP_PASSWORD=<16-character App Password>, EMAIL_FROM="Melobud <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Melobud <no-reply@example.com>

# Where links in emails point (the React app).
FRONTEND_URL=http://localhost:5173

# Audio engine: auto | cuda | cpu
AUDIO_DEVICE=auto
MAX_UPLOAD_MB=25
